---
import '@/shared/styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Chemin absolu vers l'image OG, ex. `/og/mon-jeu.png`. */
  image?: string | undefined;
  /** Couleur d'accent exposée aux styles enfants via `--accent`. */
  accent?: string | undefined;
}

const { title, description, image, accent } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* L'`.ico` en premier : certains navigateurs anciens ignorent la suite.
        Il ne contient qu'une image 16×16, d'où la taille déclarée. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1b18" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Le choix de thème, appliqué AVANT la peinture.

      `is:inline` est obligatoire : un script de module serait différé, et le
      visiteur qui a choisi le sombre verrait le crème un dixième de seconde
      avant la bascule. C'est aussi pourquoi on lit `localStorage` en direct
      plutôt que par `createStore()` — charger Zod avant le premier pixel pour
      valider une chaîne de cinq lettres serait un mauvais échange. La règle 2
      de CLAUDE.md vise l'état des jeux, pas ce réglage-ci.

      Sans valeur enregistrée, aucun attribut n'est posé : la préférence
      système continue de décider, et elle reste suivie en direct.
    */}
    <script is:inline>
      try {
        const choix = localStorage.getItem('lucagioca:theme');
        if (choix === 'dark' || choix === 'light') {
          document.documentElement.dataset.theme = choix;
        }
      } catch {
        /* Cookies bloqués : on suit le système, sans rien casser. */
      }
    </script>

    <slot name="head" />
  </head>
  <body style={accent ? `--accent: ${accent};` : undefined}>
    <slot />
  </body>
</html>
