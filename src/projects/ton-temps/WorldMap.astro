---
/**
 * La carte, rendue entièrement côté serveur.
 *
 * `map-paths.ts` pèse une centaine de kilo-octets, mais il n'est importé que
 * dans ce frontmatter : il devient du HTML et ne touche jamais le bundle JS.
 * L'island React se contente d'écouter les clics par délégation.
 *
 * Le seuil de couleur est posé ici en attribut, au build. Les deux rampes du
 * jeu — douce au choix, brutale au dernier écran — lisent le même `data-vie` :
 * changer de lecture n'est donc qu'un changement de classe sur le conteneur,
 * zéro octet de JS pour recolorer 169 pays.
 */
import { lifeBucket } from './buckets';
import { byId } from './data/countries';
import { shapes, viewBox } from './data/map-paths';
---

<svg
  class="carte"
  viewBox={viewBox}
  role="img"
  aria-label="Carte du monde. Le choix du pays se fait avec la liste déroulante ci-dessous."
  xmlns="http://www.w3.org/2000/svg"
>
  {
    shapes.map((shape) => {
      const country = shape.id ? byId.get(shape.id) : undefined;
      return (
        <path
          d={shape.d}
          data-id={country?.id}
          data-vie={country ? lifeBucket(country.years) : undefined}
          class={country ? 'pays' : 'pays sans-donnees'}
        >
          {/* Les pays avec données ont la bulle React, plus riche et instantanée ;
            un <title> ici doublerait l'infobulle native par-dessus. */}
        {!country && <title>{shape.name}</title>}
        </path>
      );
    })
  }
</svg>
