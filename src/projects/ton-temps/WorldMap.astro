---
/**
 * La carte, rendue entièrement côté serveur.
 *
 * `map-paths.ts` pèse une centaine de kilo-octets, mais il n'est importé que
 * dans ce frontmatter : il devient du HTML et ne touche jamais le bundle JS.
 * L'island React se contente d'écouter les clics par délégation.
 *
 * Les seuils de couleur sont posés ici en attribut, au build. La révélation
 * finale n'est donc qu'un changement de classe CSS — zéro octet de JS pour
 * recolorer 169 pays.
 */
import { byId, countries } from './data/countries';
import { shapes, viewBox } from './data/map-paths';

const best = Math.max(...countries.map((c) => c.years));

/** Années perdues par rapport au pays le mieux loti, par tranches de 6 ans. */
function bucketOf(years: number): number {
  return Math.min(4, Math.floor((best - years) / 6));
}
---

<svg
  class="carte"
  viewBox={viewBox}
  role="img"
  aria-label="Carte du monde. Le choix du pays se fait avec la liste déroulante ci-dessous."
  xmlns="http://www.w3.org/2000/svg"
>
  {
    shapes.map((shape) => {
      const country = shape.id ? byId.get(shape.id) : undefined;
      return (
        <path
          d={shape.d}
          data-id={country?.id}
          data-bucket={country ? bucketOf(country.years) : undefined}
          class={country ? 'pays' : 'pays sans-donnees'}
        >
          <title>{country ? `${country.name} — ${country.years} ans` : shape.name}</title>
        </path>
      );
    })
  }
</svg>
